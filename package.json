{
  "name": "dsh-git-workspace-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "English Git workflow plugin for DeepSeek Harness workspaces.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.cjs"
  },
  "scripts": {
    "build": "esbuild client.js --bundle --format=cjs --platform=browser --target=es2024 --external:react --outfile=client.cjs",
    "prepare": "pnpm run build",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js && node --check client.js && node --check git-core.js && node --check client.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.8"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
